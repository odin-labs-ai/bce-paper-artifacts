{
  "apiVersion": "odin.ai/v1alpha1",
  "kind": "EngineeringBlueprint",
  "metadata": {
    "id": "served-behavior",
    "name": "Served Behavior — deployed output varies with input (anti-mock grading arm)",
    "version": "0.1.0",
    "status": "approved",
    "ownerRole": "platform-engineer",
    "stewardRole": "blueprint-steward"
  },
  "intentRefs": [
    "vp-substance-conformance:anti-mock",
    "policy:explicit-over-implicit"
  ],
  "scope": {
    "repositories": ["example-agent"],
    "paths": ["src/**/*.ts"],
    "environments": ["staging", "production"]
  },
  "extraction": {
    "profile": "odin-extension",
    "paths": ["src/**/*.ts"],
    "guardSymbols": ["registerTool"],
    "minFiles": 1
  },
  "architecture": {
    "components": [
      { "id": "servedRuntime", "type": "odinExtension", "owner": "agent-runtime" }
    ],
    "relationships": [
      {
        "from": "servedRuntime",
        "to": "chat-completion",
        "type": "serves",
        "allowed": true
      }
    ]
  },
  "constraints": [
    {
      "id": "served-output-varies-with-input",
      "type": "behavioralInvariant",
      "severity": "critical",
      "behaviorRef": "chat-completion",
      "policyRef": "vp-substance-conformance:anti-mock"
    }
  ],
  "evidenceRequirements": [
    {
      "type": "runtimeProbe",
      "required": true,
      "onMissing": "block"
    }
  ],
  "approvals": [
    { "role": "blueprint-steward", "stage": "ratify" }
  ]
}
